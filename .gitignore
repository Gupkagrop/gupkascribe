# Standard Git Ignore for GupkaScribe Studio (Windows Desktop & Web)

# Environment Secrets
.env
.env.local
.env.*.local
*.pem
*.key
!.env.example

# Ephemeral Agent Artifacts (Strictly never commit to Git)
repomix-output.*
.gemini/
brain/
scratch/
*.temp.py
temp_*.py

# Dependencies & Virtual Environments
node_modules/
.pnpm-store/
.venv/
venv/
env/
packages/
__pycache__/
*.py[cod]
*$py.class
*.so
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Build & Compiled Outputs
dist/
build/
out/
bin/
obj/
target/
*.exe
*.dll
*.msi

# Project Media & Temporary Caches
cache/
*.wav
*.mp3
temp_audio*

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE & OS Files
.vscode/
.idea/
Thumbs.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.swo
*~
